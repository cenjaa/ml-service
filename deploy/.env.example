# =============================================================
#  .env.example — ML Service
#  Copy this to .env and fill in real values.
#  DO NOT commit .env to version control.
#
#  MinIO runs in the backend compose stack and is reachable by
#  service name "minio" on the shared app_network.
# =============================================================

# ── MinIO (Object Storage) ───────────────────────────────────
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=your_minio_access_key_here
MINIO_SECRET_KEY=your_minio_secret_key_here
MINIO_BUCKET=attendance
MINIO_USE_SSL=false
